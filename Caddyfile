# Caddyfile for the Ticket Project home-network deployment.
#
# Caddy terminates HTTPS (using the mkcert-generated certificate mounted at
# /etc/caddy/certs) and routes traffic to the frontend and backend services
# on the internal Docker network. Caddy automatically redirects HTTP (port
# 80) to HTTPS (port 443).
#
# {$SITE_HOST} is substituted from the SITE_HOST environment variable passed
# to the caddy container in compose.yaml (defaults to ticketproject.local).

{$SITE_HOST} {
    # Use the locally-trusted certificate generated by scripts/make-certs.sh.
    tls /etc/caddy/certs/{$SITE_HOST}.pem /etc/caddy/certs/{$SITE_HOST}-key.pem

    # REST API -> Spring Boot backend.
    handle /api/* {
        reverse_proxy backend:8080
    }

    # API documentation (springdoc / Swagger UI) -> Spring Boot backend.
    handle /swagger-ui/* {
        reverse_proxy backend:8080
    }
    handle /v3/api-docs* {
        reverse_proxy backend:8080
    }

    # Everything else -> the React frontend.
    handle {
        reverse_proxy frontend:80
    }
}
